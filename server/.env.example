# Пример конфигурации JARVIS 2 API.
# Реальные секреты храните только в защищённом окружении сервера.
# Никогда не добавляйте действующий API-ключ в Git или браузер.

HOST=127.0.0.1
PORT=8787
APP_ORIGIN=http://localhost:5173
# При настройке публичного сервера задайте длинный случайный токен доступа.
# Сохраните его в менеджере секретов сервера и в настройках JARVIS на своих устройствах.
API_ACCESS_TOKEN=
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Резервный вариант (если OpenRouter недоступен):
# AI_PROVIDER=groq
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=
AI_TIMEOUT_MS=25000
MAX_REQUEST_BYTES=16384
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Следующие параметры зарезервированы для будущих модулей:
DATABASE_URL=
AUTH_ISSUER=
