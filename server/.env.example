# Пример конфигурации JARVIS 2 API.
# Реальные секреты храните только в защищённом окружении сервера.
# Никогда не добавляйте действующий API-ключ в Git или браузер.

HOST=127.0.0.1
PORT=8787
APP_ORIGIN=http://localhost:5173
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=
AI_TIMEOUT_MS=25000
MAX_REQUEST_BYTES=16384

# Следующие параметры зарезервированы для будущих модулей:
DATABASE_URL=
AUTH_ISSUER=
