# Пример конфигурации JARVIS 2 API.
# Реальные секреты храните только в защищённом окружении сервера.
# Никогда не добавляйте действующий API-ключ в Git или браузер.

HOST=127.0.0.1
PORT=8787
APP_ORIGIN=http://localhost:5173
API_ACCESS_TOKEN=
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AI_API_KEY=
AI_TIMEOUT_MS=25000
MAX_REQUEST_BYTES=16384
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Web Push: создайте VAPID-ключи командой npm run generate:vapid-keys.
# Приватный ключ храните только в секретах сервера.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
PUSH_STORE_PATH=server/data/push-subscriptions.json
REMINDER_STORE_PATH=server/data/push-reminders.json
